# Export explicitly from this folder; Go does not load this file automatically.
HTTP_ADDR=:8086
DATABASE_URL=postgres://qslate:replace-with-independent-password@127.0.0.1:5432/qslate_marketplace?sslmode=disable
AUTH_SERVICE_URL=http://127.0.0.1:8081
WIDGETS_SERVICE_URL=http://127.0.0.1:8083
STRATEGY_SERVICE_URL=http://127.0.0.1:8084
JWT_PUBLIC_KEY_FILE=/absolute/path/to/auth-public.pem
MARKETPLACE_CONFIG_FILE=config/marketplace.json
