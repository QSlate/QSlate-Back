# Export explicitly when running from this directory. No dotenv autoloading.
HTTP_ADDR=:8088
DATABASE_URL=postgres://qslate:replace-with-market-data-secret@localhost:5432/qslate_market_data?sslmode=disable
AUTH_SERVICE_URL=http://localhost:8081
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
MARKET_DATA_CONFIG_FILE=config/market-data.json
MARKET_DATA_PARSER_URL=http://localhost:8089
# Optional trusted source adapter, enabled separately in JSON:
# MARKET_DATA_FEED_URL=https://your-trusted-market-feed.example
# MARKET_DATA_FEED_TOKEN=inject-at-runtime
