# Export from the Auth folder; inject your own database/key/SMTP settings.
HTTP_ADDR=:8081
DATABASE_URL=postgres://user:password@127.0.0.1:5432/qslate_auth?sslmode=disable
JWT_PRIVATE_KEY_FILE=/absolute/path/to/auth-private.pem
OAUTH_PROVIDERS_FILE=config/providers.json
JWT_ISSUER=qslate-auth
JWT_AUDIENCE=qslate-api
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SMTP_ADDR=localhost:1025
SMTP_FROM=noreply@qslate.local
SMTP_TLS_MODE=starttls
# COOKIE_SECURE=false is allowed only for local plain HTTP development.
