# Export from this service folder; Go does not load .env automatically.
HTTP_ADDR=:8084
# Optional installed read-only community snapshots; unset for standalone drafts.
# MARKETPLACE_SERVICE_URL=http://127.0.0.1:8086
DATABASE_URL=postgres://user:password@127.0.0.1:5432/qslate_strategy?sslmode=disable
AUTH_SERVICE_URL=http://127.0.0.1:8081
JWT_PUBLIC_KEY_FILE=/absolute/path/to/auth-public.pem
JWT_ISSUER=qslate-auth
JWT_AUDIENCE=qslate-api
STRATEGY_CONFIG_FILE=config/strategy.json
STRATEGY_ANALYZER_URL=http://127.0.0.1:8085
