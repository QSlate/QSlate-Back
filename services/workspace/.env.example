# Export from this service folder; Go does not load .env automatically.
HTTP_ADDR=:8082
DATABASE_URL=postgres://user:password@127.0.0.1:5432/qslate_workspace?sslmode=disable
AUTH_SERVICE_URL=http://127.0.0.1:8081
JWT_PUBLIC_KEY_FILE=/absolute/path/to/auth-public.pem
JWT_ISSUER=qslate-auth
JWT_AUDIENCE=qslate-api
WORKSPACE_LAYOUT_FILE=config/layout.json
WIDGETS_SERVICE_URL=http://127.0.0.1:8083
