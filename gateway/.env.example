# Export from the gateway folder; Go does not load .env automatically.
HTTP_ADDR=:8080
ROUTES_FILE=config/routes.json
JWT_PUBLIC_KEY_FILE=/absolute/path/to/auth-public.pem
JWT_ISSUER=qslate-auth
JWT_AUDIENCE=qslate-api
AUTH_SERVICE_URL=http://127.0.0.1:8081
WORKSPACE_SERVICE_URL=http://127.0.0.1:8082
WIDGETS_SERVICE_URL=http://127.0.0.1:8083
STRATEGY_SERVICE_URL=http://127.0.0.1:8084
ALLOWED_ORIGINS=http://localhost:3000
