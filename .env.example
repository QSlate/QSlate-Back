# make init creates .env with a random database password and the local UID/GID.
AUTH_DATABASE_PASSWORD=replace-with-a-random-hex-password
WORKSPACE_DATABASE_PASSWORD=replace-with-a-different-random-hex-password
WIDGETS_DATABASE_PASSWORD=replace-with-another-independent-random-hex-password
GATEWAY_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
MAILPIT_PORT=8025
QSLATE_UID=1000
QSLATE_GID=1000

# Local Go processes: run from the component folder; see its .env.example.
# Pass DATABASE_URL and key paths explicitly. Go does not load .env automatically.
# DATABASE_URL=postgres://qslate:password@127.0.0.1:5432/qslate_auth?sslmode=disable
# AUTH_SERVICE_URL=http://127.0.0.1:8081
# WORKSPACE_SERVICE_URL=http://127.0.0.1:8082
# WIDGETS_SERVICE_URL=http://127.0.0.1:8083
# WIDGETS_CONFIG_FILE=config/catalogue.json
# WIDGET_PREVIEW_URL=https://trusted-sandbox-controller.example/preview
# WIDGET_PREVIEW_TOKEN=inject-from-a-secret-manager-only-when-preview-is-enabled
# WORKSPACE_LAYOUT_FILE=config/layout.json
# JWT_PRIVATE_KEY_FILE=.secrets/auth-private.pem
# JWT_PUBLIC_KEY_FILE=.secrets/auth-public.pem
# OAUTH_PROVIDERS_FILE=config/providers.json
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
# COOKIE_SECURE=true
# SMTP_ADDR=localhost:1025
# SMTP_FROM=noreply@qslate.local
# SMTP_TLS_MODE=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Compose uses Mailpit (plain SMTP) and COOKIE_SECURE=false for local HTTP only.
# Provider credentials belong in .env.oauth; see .env.oauth.example.
